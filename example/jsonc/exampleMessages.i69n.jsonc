{
  // Default (English) messages. JSONC lets us annotate translations inline.
  // The Gender enum the _select messages below branch on:
  "_i69n_import": "../gender.dart",
  "generic": {
    "_i69n": "flag",
    "ok": "OK",
    "done": "DONE",
    "letsGo": "Let's go!"
  },
  "invoice": {
    "_i69n": "noescape,nomap",
    "create": "Create invoice",
    "delete": "Delete  invoice",
    "help": "Use this function to generate new invoices and stuff. Awesome!",
    "count(int cnt)": "You have created $cnt ${_plural(cnt, one:'invoice', many:'invoices')}."
  },
  "apples": {
    "_apples(int cnt)": "${_plural(cnt, zero: 'no apples', one:'$cnt apple', many:'$cnt apples')}",
    "count(int cnt)": "You have eaten ${_apples(cnt)}."
  },
  /* _select branches on an enum value; `other` catches the rest. */
  "person": {
    "sees(Gender gender)": "I see ${_select(gender, male: 'him', female: 'her', other: 'them')}.",
    "owns(Gender gender, int cnt)": "${_select(gender, male: 'His', female: 'Her', other: 'Their')} ${_plural(cnt, one: 'apple', many: 'apples')}."
  }
}
